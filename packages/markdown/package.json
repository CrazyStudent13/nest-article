{
  "name": "@nest-acticle/markdown",
  "version": "1.7.0",
  "private": true,
  "description": "monorepo Markdown 渲染共享包：markdown-it+highlight.js 渲染器与 .markdown-body 样式，client/admin 两端 MdViewer 薄壳共用（同一段 markdown 两端输出完全一致的 HTML）",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-styles.mjs",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@mdit/plugin-katex": "^1.2.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.1",
    "markdown-it": "^14.1.0",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "less": "^4.2.0",
    "tsup": "^8.0.0"
  }
}
