# 复制本文件为 .env 后按需修改；docker compose 从根目录读取本文件
#
# 变量归属速查：
#   MYSQL_* / REDIS_PASSWORD      → mysql / redis 容器
#   JWT_SECRETKEY / SERVER_PORT / MAIL_* → blog-server（NestJS 后端）
#   NUXT_PUBLIC_API_BASE / NUXT_API_PROXY_TARGET → blog-client（Nuxt 博客前台）
#   BLOG_PORT                     → blog-nginx（博客前台入口）
#   ADMIN_PORT                    → blog-admin（管理后台入口）
#   IMAGE_PREFIX                  → 全部镜像的命名前缀

# ===== mysql / redis 容器（数据库与缓存；MYSQL_USERNAME/PASSWORD 还会注入 server 容器）=====
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=nest-db
MYSQL_USERNAME=root
MYSQL_PASSWORD=root123
REDIS_PASSWORD=

# ===== blog-server（NestJS 后端容器）=====
# 生产必填：joi 校验非空，缺失直接拒绝启动；务必换成复杂随机值
JWT_SECRETKEY=please-change-me-to-a-random-secret
# 容器内监听端口（blog-nginx 反代指向它）
SERVER_PORT=8080
# 接口文档开关（Swagger UI / Redoc / openapi.json，经 /api 前缀访问）：本地或内网开 true 方便调试，
# 公网部署务必保持 false——镜像固定 NODE_ENV=production、prod.yml 默认关闭，此项是唯一的打开通道
SWAGGER_ENABLE=false

# ===== blog-server 邮件（可选：MAIL_ENABLED=true 且 host/user/pass 齐全时注册走邮箱验证码，否则图形验证码）=====
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# ===== blog-client（Nuxt 博客前台）=====
# 后端入口前缀：留空走同源相对路径（推荐）——浏览器经 nginx 同源访问 /api、/profile，
# SSR 相对请求由 Nitro 代理路由转发到 NUXT_API_PROXY_TARGET，换网络/换部署机零配置；
# 仅无 nginx 反代的特殊部署才需要填绝对地址（如 http://192.168.x.x:8888）
NUXT_PUBLIC_API_BASE=
# /api、/profile 代理转发目标：docker 默认 http://server:8080（compose 注入），本地 dev 默认 http://localhost:8080
# NUXT_API_PROXY_TARGET=http://localhost:8080

# ===== 对外端口 =====
BLOG_PORT=8888   # blog-nginx
ADMIN_PORT=8081  # blog-admin

# ===== 镜像命名（部署用）=====
# 必须与 GitHub 仓库的 <用户名>/<仓库名> 一致（全小写），Actions 按此规则推镜像
# 本地 docker compose up --build 不受影响：本地构建产出同名镜像
IMAGE_PREFIX=ghcr.io/crazystudent13/nest-acticle
